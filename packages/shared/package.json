{
  "name": "@bidding-kitchen/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic domain models, contracts, and canonical game data",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim:burger": "tsx src/sim/cli-report.ts",
    "sim:all": "tsx src/sim/cli-report.ts --all"
  },
  "dependencies": {},
  "devDependencies": {
    "@fast-check/vitest": "^0.1.2",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
